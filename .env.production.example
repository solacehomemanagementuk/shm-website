NODE_ENV=production
APP_ORIGIN=https://your-site.netlify.app
DATABASE_URL=provided-by-the-managed-postgresql-host
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
SESSION_SECRET=generated-by-the-backend-host
PROXY_SHARED_SECRET=generate-at-least-32-random-bytes-and-share-with-netlify
TRUST_PROXY=1

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM="Solace Home Management <your-account@gmail.com>"

SHM_BACKEND_URL=https://your-auth-api-host.example
